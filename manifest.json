{
  "manifest_version": 3,

  "name": "Recipe Extension",

  "version": "1.0",

  "description": "Extension to save recipes from web pages",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "extension/popup.html"
  },

  "background": {
    "service_worker": "extension/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["extension/content.js"]
    }
  ]
}